 2556.92, "end": 2557.0}, {"word": "immigrant", "start": 2557.0, "end": 2557.3}, {"word": "crossing.", "start": 2557.3, "end": 2557.66}, {"word": "The", "start": 2558.3, "end": 2558.34}, {"word": "Edison", "start": 2558.34, "end": 2558.58}, {"word": "rivalry.", "start": 2558.58, "end": 2558.9}]}, {"start": 2559.62, "end": 2568.22, "text": "The war of currents. All of this is known. Documented. Verifiable. The short version. Tesla won.", "no_speech_prob": 0.152, "words": [{"word": "The", "start": 2559.62, "end": 2559.8}, {"word": "war", "start": 2559.8, "end": 2559.98}, {"word": "of", "start": 2559.98, "end": 2560.1}, {"word": "currents.", "start": 2560.1, "end": 2560.38}, {"word": "All", "start": 2561.54, "end": 2561.78}, {"word": "of", "start": 2561.78, "end": 2561.88}, {"word": "this", "start": 2561.88, "end": 2562.1}, {"word": "is", "start": 2562.1, "end": 2562.26}, {"word": "known.", "start": 2562.26, "end": 2562.56}, {"word": "Documented.", "start": 2563.18, "end": 2563.78}, {"word": "Verifiable.", "start": 2564.44, "end": 2564.92}, {"word": "The", "start": 2566.12, "end": 2566.24}, {"word": "short", "start": 2566.24, "end": 2566.46}, {"word": "version.", "start": 2566.46, "end": 2566.76}, {"word": "Tesla", "start": 2567.48, "end": 2567.84}, {"word": "won.", "start": 2567.84, "end": 2568.22}]}, {"start": 2569.14, "end": 2573.18, "text": "His alternating current system became the dominant standard for electrical power", "no_speech_prob": 0.152, "words": [{"word": "His", "start": 2569.14, "end": 2569.54}, {"word": "alternating", "start": 2569.54, "end": 2569.94}, {"word": "current", "start": 2569.94, "end": 2570.36}, {"word": "system", "start": 2570.36, "end": 2570.8}, {"word": "became", "start": 2570.8, "end": 2571.22}, {"word": "the", "start": 2571.22, "end": 2571.4}, {"word": "dominant", "start": 2571.4, "end": 2571.7}, {"word": "standard", "start": 2571.7, "end": 2572.16}, {"word": "for", "start": 2572.16, "end": 2572.42}, {"word": "electrical", "start": 2572.42, "end": 2572.84}, {"word": "power", "start": 2572.84, "end": 2573.18}]}, {"start": 2573.18, "end": 2578.4, "text": "distribution worldwide. The long version is the shape of how he won and what it cost.", "no_speech_prob": 0.152, "words": [{"word": "distribution", "start": 2573.18, "end": 2573.74}, {"word": "worldwide.", "start": 2573.74, "end": 2574.24}, {"word": "The", "start": 2575.24, "end": 2575.58}, {"word": "long", "start": 2575.58, "end": 2575.78}, {"word": "version", "start": 2575.78, "end": 2576.14}, {"word": "is", "start": 2576.14, "end": 2576.4}, {"word": "the", "start": 2576.4, "end": 2576.54}, {"word": "shape", "start": 2576.54, "end": 2576.78}, {"word": "of", "start": 2576.78, "end": 2576.96}, {"word": "how", "start": 2576.96, "end": 2577.12}, {"word": "he", "start": 2577.12, "end": 2577.26}, {"word": "won", "start": 2577.26, "end": 2577.54}, {"word": "and", "start": 2577.54, "end": 2577.88}, {"word": "what", "start": 2577.88, "end": 2578.06}, {"word": "it", "start": 2578.06, "end": 2578.16}, {"word": "cost.", "start": 2578.16, "end": 2578.4}]}, {"start": 2579.28, "end": 2583.88, "text": "He gave George Westinghouse his Niagara patents for far less than their value.", "no_speech_prob": 0.006, "words": [{"word": "He", "start": 2579.24, "end": 2579.56}, {"word": "gave", "start": 2579.56, "end": 2579.78}, {"word": "George", "start": 2579.78, "end": 2580.1}, {"word": "Westinghouse", "start": 2580.1, "end": 2580.8}, {"word": "his", "start": 2580.8, "end": 2581.02}, {"word": "Niagara", "start": 2581.02, "end": 2581.32}, {"word": "patents", "start": 2581.32, "end": 2581.8}, {"word": "for", "start": 2581.8, "end": 2582.48}, {"word": "far", "start": 2582.48, "end": 2582.76}, {"word": "less", "start": 2582.76, "end": 2583.08}, {"word": "than", "start": 2583.08, "end": 2583.34}, {"word": "their", "start": 2583.34, "end": 2583.54}, {"word": "value.", "start": 2583.54, "end": 2583.88}]}, {"start": 2584.26, "end": 2587.8, "text": "Because Westinghouse told him the company could not survive otherwise.", "no_speech_prob": 0.006, "words": [{"word": "Because", "start": 2584.26, "end": 2584.5}, {"word": "Westinghouse", "start": 2584.5, "end": 2585.16}, {"word": "told", "start": 2585.16, "end": 2585.42}, {"word": "him", "start": 2585.42, "end": 2585.7}, {"word": "the", "start": 2585.7, "end": 2585.92}, {"word": "company", "start": 2585.92, "end": 2586.3}, {"word": "could", "start": 2586.3, "end": 2586.56}, {"word": "not", "start": 2586.56, "end": 2586.84}, {"word": "survive", "start": 2586.84, "end": 2587.3}, {"word": "otherwise.", "start": 2587.3, "end": 2587.8}]}, {"start": 2588.98, "end": 2593.48, "text": "The traditional account says Tesla voluntarily tore up the royalty contract.", "no_speech_prob": 0.006, "words": [{"word": "The", "start": 2588.98, "end": 2589.08}, {"word": "traditional", "start": 2589.08, "end": 2589.52}, {"word": "account", "start": 2589.52, "end": 2590.02}, {"word": "says", "start": 2590.02, "end": 2590.66}, {"word": "Tesla", "start": 2590.66, "end": 2591.1}, {"word": "voluntarily", "start": 2591.1, "end": 2591.82}, {"word": "tore", "start": 2591.82, "end": 2592.14}, {"word": "up", "start": 2592.14, "end": 2592.38}, {"word": "the", "start": 2592.38, "end": 2592.56}, {"word": "royalty", "start": 2592.56, "end": 2592.86}, {"word": "contract.", "start": 2592.86, "end": 2593.48}]}, {"start": 2593.96, "end": 2599.36, "text": "That he handed over the basis of the electrical century as an act of will. Not of necessity.", "no_speech_prob": 0.006, "words": [{"word": "That", "start": 2593.96, "end": 2594.14}, {"word": "he", "start": 2594.14, "end": 2594.22}, {"word": "handed", "start": 2594.22, "end": 2594.44}, {"word": "over", "start": 2594.44, "end": 2594.72}, {"word": "the", "start": 2594.72, "end": 2594.86}, {"word": "basis", "start": 2594.86, "end": 2595.22}, {"word": "of", "start": 2595.22, "end": 2595.5}, {"word": "the", "start": 2595.5, "end": 2595.64}, {"word": "electrical", "start": 2595.64, "end": 2596.04}, {"word": "century", "start": 2596.04, "end": 2596.54}, {"word": "as", "start": 2596.54, "end": 2597.04}, {"word": "an", "start": 2597.04, "end": 2597.16}, {"word": "act", "start": 2597.16, "end": 2597.42}, {"word": "of", "start": 2597.42, "end": 2597.56}, {"word": "will.", "start": 2597.56, "end": 2597.86}, {"word": "Not", "start": 2598.36, "end": 2598.66}, {"word": "of", "start": 2598.66, "end": 2599.0}, {"word": "necessity.", "start": 2599.0, "end": 2599.36}]}, {"start": 2600.68, "end": 2607.72, "text": "Modern historians debate that framing. What is not in dispute. Tesla received far less", "no_speech_prob": 0.006, "words": [{"word": "Modern", "start": 2600.68, "end": 2601.24}, {"word": "historians", "start": 2601.24, "end": 2601.88}, {"word": "debate", "start": 2601.88, "end": 2602.3}, {"word": "that", "start": 2602.3, "end": 2602.64}, {"word": "framing.", "start": 2602.64, "end": 2602.94}, {"word": "What", "start": 2603.94, "end": 2604.36}, {"word": "is", "start": 2604.36, "end": 2604.5}, {"word": "not", "start": 2604.5, "end": 2604.74}, {"word": "in", "start": 2604.74, "end": 2604.98}, {"word": "dispute.", "start": 2604.98, "end": 2605.3}, {"word": "Tesla", "start": 2606.0, "end": 2606.56}, {"word": "received", "start": 2606.56, "end": 2607.1}, {"word": "far", "start": 2607.1, "end": 2607.4}, {"word": "less", "start": 2607.4, "end": 2607.72}]}, {"start": 2607.72, "end": 2612.4, "text": "than those patents were worth. And the century they powered did not reciprocate.", "no_speech_prob": 0.011, "words": [{"word": "than", "start": 2607.72, "end": 2608.02}, {"word": "those", "start": 2608.02, "end": 2608.26}, {"word": "patents", "start": 2608.26, "end": 2608.6}, {"word": "were", "start": 2608.6, "end": 2608.88}, {"word": "worth.", "start": 2608.88, "end": 2609.16}, {"word": "And", "start": 2609.82, "end": 2610.06}, {"word": "the", "start": 2610.06, "end": 2610.2}, {"word": "century", "start": 2610.2, "end": 2610.52}, {"word": "they", "start": 2610.52, "end": 2610.72}, {"word": "powered", "start": 2610.72, "end": 2611.08}, {"word": "did", "start": 2611.08, "end": 2611.44}, {"word": "not", "start": 2611.44, "end": 2611.7}, {"word": "reciprocate.", "start": 2611.7, "end": 2612.4}]}, {"start": 2613.24, "end": 2619.88, "text": "Then Wardencliff. A tower on Long Island. Designed to transmit electrical power wirelessly across the", "no_speech_prob": 0.011, "words": [{"word": "Then", "start": 2613.24, "end": 2613.48}, {"word": "Wardencliff.", "start": 2613.48, "end": 2614.24}, {"word": "A", "start": 2614.82, "end": 2614.98}, {"word": "tower", "start": 2614.98, "end": 2615.3}, {"word": "on", "start": 2615.3, "end": 2615.6}, {"word": "Long", "start": 2615.6, "end": 2615.8}, {"word": "Island.", "start": 2615.8, "end": 2616.08}, {"word": "Designed", "start": 2616.64, "end": 2617.04}, {"word": "to", "start": 2617.04, "end": 2617.14}, {"word": "transmit", "start": 2617.14, "end": 2617.56}, {"word": "electrical", "start": 2617.56, "end": 2618.1}, {"word": "power", "start": 2618.1, "end": 2618.56}, {"word": "wirelessly", "start": 2618.56, "end": 2619.26}, {"word": "across", "start": 2619.26, "end": 2619.6}, {"word": "the", "start": 2619.6, "end": 2619.88}]}, {"start": 2619.88, "end": 2628.0, "text": "planet. Not through wires. Through the earth itself. The planet was a conductor. Which it is.", "no_speech_prob": 0.011, "words": [{"word": "planet.", "start": 2619.88, "end": 2620.18}, {"word": "Not", "start": 2621.0, "end": 2621.46}, {"word": "through", "start": 2621.46, "end": 2621.68}, {"word": "wires.", "start": 2621.68, "end": 2622.06}, {"word": "Through", "start": 2622.86, "end": 2623.14}, {"word": "the", "start": 2623.14, "end": 2623.28}, {"word": "earth", "start": 2623.28, "end": 2623.6}, {"word": "itself.", "start": 2623.6, "end": 2624.02}, {"word": "The", "start": 2625.04, "end": 2625.54}, {"word": "planet", "start": 2625.54, "end": 2625.82}, {"word": "was", "start": 2625.82, "end": 2626.18}, {"word": "a", "start": 2626.18, "end": 2626.32}, {"word": "conductor.", "start": 2626.32, "end": 2626.76}, {"word": "Which", "start": 2627.46, "end": 2627.58}, {"word": "it", "start": 2627.58, "end": 2627.76}, {"word": "is.", "start": 2627.76, "end": 2628.0}]}, {"start": 2628.78, "end": 2633.24, "text": "And if you could induce the right resonant frequency in it. You could make energy as", "no_speech_prob": 0.011, "words": [{"word": "And", "start": 2628.78, "end": 2629.02}, {"word": "if", "start": 2629.02, "end": 2629.14}, {"word": "you", "start": 2629.14, "end": 2629.28}, {"word": "could", "start": 2629.28, "end": 2629.42}, {"word": "induce", "start": 2629.42, "end": 2629.76}, {"word": "the", "start": 2629.76, "end": 2630.04}, {"word": "right", "start": 2630.04, "end": 2630.32}, {"word": "resonant", "start": 2630.32, "end": 2630.88}, {"word": "frequency", "start": 2630.88, "end": 2631.34}, {"word": "in", "start": 2631.34, "end": 2631.56}, {"word": "it.", "start": 2631.56, "end": 2631.72}, {"word": "You", "start": 2632.22, "end": 2632.4}, {"word": "could", "start": 2632.4, "end": 2632.52}, {"word": "make", "start": 2632.52, "end": 2632.72}, {"word": "energy", "start": 2632.72, "end": 2633.1}, {"word": "as", "start": 2633.1, "end": 2633.41}]}, {"start": 2633.41, "end": 2641.07, "text": "ubiquitous as air. Present everywhere. Available to anyone. His primary investor was JP Morgan.", "no_speech_prob": 0.09, "words": [{"word": "ubiquitous", "start": 2633.41, "end": 2633.99}, {"word": "as", "start": 2633.99, "end": 2634.17}, {"word": "air.", "start": 2634.17, "end": 2634.41}, {"word": "Present", "start": 2635.13, "end": 2635.35}, {"word": "everywhere.", "start": 2635.35, "end": 2635.89}, {"word": "Available", "start": 2636.59, "end": 2636.99}, {"word": "to", "start": 2636.99, "end": 2637.31}, {"word": "anyone.", "start": 2637.31, "end": 2637.55}, {"word": "His", "start": 2638.53, "end": 2638.97}, {"word": "primary", "start": 2638.97, "end": 2639.35}, {"word": "investor", "start": 2639.35, "end": 2639.89}