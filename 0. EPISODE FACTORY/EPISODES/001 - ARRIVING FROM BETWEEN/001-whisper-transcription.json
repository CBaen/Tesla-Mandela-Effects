 "end": 2713.61}, {"word": "documented.", "start": 2713.61, "end": 2714.03}, {"word": "In", "start": 2714.85, "end": 2715.03}, {"word": "the", "start": 2715.03, "end": 2715.13}, {"word": "way", "start": 2715.13, "end": 2715.33}, {"word": "that", "start": 2715.33, "end": 2715.53}, {"word": "things", "start": 2715.53, "end": 2715.77}, {"word": "a", "start": 2715.77, "end": 2715.95}, {"word": "person", "start": 2715.95, "end": 2716.27}, {"word": "cannot", "start": 2716.27, "end": 2716.71}, {"word": "say", "start": 2716.71, "end": 2717.05}, {"word": "directly.", "start": 2717.05, "end": 2717.55}]}, {"start": 2717.99, "end": 2724.11, "text": "Are sometimes documented in what they do say. Tesla wrote about people with genuine interest.", "no_speech_prob": 0.001, "words": [{"word": "Are", "start": 2717.99, "end": 2718.23}, {"word": "sometimes", "start": 2718.23, "end": 2718.55}, {"word": "documented", "start": 2718.55, "end": 2719.29}, {"word": "in", "start": 2719.29, "end": 2719.75}, {"word": "what", "start": 2719.75, "end": 2719.89}, {"word": "they", "start": 2719.89, "end": 2720.05}, {"word": "do", "start": 2720.05, "end": 2720.31}, {"word": "say.", "start": 2720.31, "end": 2720.61}, {"word": "Tesla", "start": 2721.53, "end": 2721.87}, {"word": "wrote", "start": 2721.87, "end": 2722.27}, {"word": "about", "start": 2722.27, "end": 2722.59}, {"word": "people", "start": 2722.59, "end": 2722.95}, {"word": "with", "start": 2722.95, "end": 2723.25}, {"word": "genuine", "start": 2723.25, "end": 2723.59}, {"word": "interest.", "start": 2723.59, "end": 2724.11}]}, {"start": 2724.89, "end": 2728.55, "text": "Occasionally with warmth. But the warmth had a quality.", "no_speech_prob": 0.001, "words": [{"word": "Occasionally", "start": 2724.89, "end": 2725.53}, {"word": "with", "start": 2725.53, "end": 2725.71}, {"word": "warmth.", "start": 2725.71, "end": 2726.01}, {"word": "But", "start": 2727.07, "end": 2727.35}, {"word": "the", "start": 2727.35, "end": 2727.45}, {"word": "warmth", "start": 2727.45, "end": 2727.79}, {"word": "had", "start": 2727.79, "end": 2728.05}, {"word": "a", "start": 2728.05, "end": 2728.15}, {"word": "quality.", "start": 2728.15, "end": 2728.55}]}, {"start": 2729.57, "end": 2732.93, "text": "The warmth of someone watching a species they found fascinating.", "no_speech_prob": 0.001, "words": [{"word": "The", "start": 2729.57, "end": 2729.93}, {"word": "warmth", "start": 2729.93, "end": 2730.23}, {"word": "of", "start": 2730.23, "end": 2730.45}, {"word": "someone", "start": 2730.45, "end": 2730.81}, {"word": "watching", "start": 2730.81, "end": 2731.27}, {"word": "a", "start": 2731.27, "end": 2731.47}, {"word": "species", "start": 2731.47, "end": 2731.83}, {"word": "they", "start": 2731.83, "end": 2732.17}, {"word": "found", "start": 2732.17, "end": 2732.43}, {"word": "fascinating.", "start": 2732.43, "end": 2732.93}]}, {"start": 2733.61, "end": 2738.33, "text": "Rather than sharing territory with them. He was fluent in eight languages.", "no_speech_prob": 0.001, "words": [{"word": "Rather", "start": 2733.61, "end": 2734.01}, {"word": "than", "start": 2734.01, "end": 2734.33}, {"word": "sharing", "start": 2734.33, "end": 2734.69}, {"word": "territory", "start": 2734.69, "end": 2735.07}, {"word": "with", "start": 2735.07, "end": 2735.45}, {"word": "them.", "start": 2735.45, "end": 2735.59}, {"word": "He", "start": 2736.61, "end": 2736.93}, {"word": "was", "start": 2736.93, "end": 2737.07}, {"word": "fluent", "start": 2737.07, "end": 2737.33}, {"word": "in", "start": 2737.33, "end": 2737.63}, {"word": "eight", "start": 2737.63, "end": 2737.95}, {"word": "languages.", "start": 2737.95, "end": 2738.33}]}, {"start": 2739.31, "end": 2743.69, "text": "He could hold a conversation that left the other party electrified and breathless.", "no_speech_prob": 0.036, "words": [{"word": "He", "start": 2739.31, "end": 2739.87}, {"word": "could", "start": 2739.87, "end": 2739.97}, {"word": "hold", "start": 2739.97, "end": 2740.21}, {"wor